# ============================================
# DocTheraLink Frontend Configuration
# ============================================

# ============================================
# Branding / Whitelabelling
# ============================================
REACT_APP_TITLE=Klyniva
REACT_APP_META_DESCRIPTION="Advanced Healthcare Management System: Klyniva provides comprehensive tools for healthcare facility management, patient care, and medical administration."
REACT_APP_COVER_IMAGE=/images/klyniva.png
REACT_APP_COVER_IMAGE_ALT=/images/klyniva.png
REACT_PUBLIC_URL=https://klyniva.com

# ============================================
# API Configuration
# ============================================
# Leave empty for Docker (runtime config.js will set it)
# For local development, set to: http://localhost:9000
REACT_CARE_API_URL=

# ============================================
# Localization
# ============================================
REACT_ALLOWED_LOCALES="en,pt"

# ============================================
# Development
# ============================================
ESLINT_NO_DEV_ERRORS=true

# ============================================
# CDN / Storage
# ============================================
CARE_CDN_URL="https://egov-s3-facility-10bedicu.s3.amazonaws.com https://egov-s3-patient-data-10bedicu.s3.amazonaws.com http://localhost:4566"

# ============================================
# Feature Flags
# ============================================
REACT_ENABLE_HCX=false
REACT_ENABLE_ABDM=true

# ============================================
# Plugin Apps (Comma-separated)
# ============================================
# Example: package@branch,another-package@main
REACT_ENABLED_APPS=""

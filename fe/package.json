{
  "name": "klyniva_fe",
  "version": "2.5.4",
  "description": "Klyniva is an advanced healthcare management system enabling comprehensive patient care and facility administration.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git@github.com:klyniva/klyniva_fe.git"
  },
  "bugs": {
    "url": "https://github.com/klyniva/klyniva_fe/issues",
    "email": "info@klyniva.com"
  },
  "contributors": [
    "Klyniva Contributors"
  ],
  "homepage": "https://klyniva.com",
  "keywords": [
    "klyniva",
    "healthcare",
    "react",
    "tailwind",
    "pwa",
    "typescript",
    "vite"
  ],
  "author": "Klyniva Contributors",
  "license": "MIT",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run supported-browsers && vite",
    "local": "npm run supported-browsers && vite --mode docker",
    "preview": "cross-env NODE_ENV=production vite preview",
    "build:meta": "node ./scripts/generate-build-version.js",
    "build:react": "cross-env NODE_ENV=production vite build",
    "supported-browsers": "node ./scripts/generate-supported-browsers.mjs",
    "build": "npm run install-all && npm run build:meta && npm run supported-browsers && npm run build:react",
    "setup": "node scripts/setup-care-apps.js",
    "install-all": "npm install && npm run setup && npm install",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:security": "snyk test",
    "generate": "node scripts/setup-care-apps.js && npm run supported-browsers",
    "typecheck": "npm run generate && tsc --noEmit",
    "cypress:open": "cross-env NODE_ENV=development cypress open",
    "cypress:run": "cross-env NODE_ENV=development cypress run",
    "cypress:run:gui": "cross-env NODE_ENV=development cypress run --headed",
    "cypress:install": "cross-env NODE_ENV=development cypress install",
    "prepare": "husky",
    "lint": "eslint ./src",
    "lint:strict": "eslint --max-warnings=0 src/components/Referral src/components/Patient/PatientList.tsx src/components/Patient/PatientForm.tsx src/components/Patient/PatientDetail.tsx src/components/Patient/patientFormUtils.ts src/components/Patient/patientFormUtils.test.ts src/Utils/roles.ts src/Utils/person.ts src/hooks/useDebouncedValue.ts src/components/Notifications src/components/Facility/FacilityCard.tsx src/Routers src/test",
    "lint-fix": "eslint ./src --fix",
    "format": "prettier ./src ./cypress --write",
    "sort-locales": "node ./scripts/sort-locales.js"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.1.1",
    "@googlemaps/react-wrapper": "^1.1.42",
    "@googlemaps/typescript-guards": "^2.0.3",
    "@headlessui/react": "^2.2.0",
    "@hello-pangea/dnd": "^17.0.0",
    "@pnotify/core": "^5.2.0",
    "@pnotify/mobile": "^5.2.0",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@sentry/browser": "^8.47.0",
    "@tanstack/react-query": "^5.62.8",
    "@tanstack/react-query-devtools": "^5.62.7",
    "axios": "^1.7.7",
    "bowser": "^2.11.0",
    "browser-image-compression": "^2.0.2",
    "browserslist": "^4.24.3",
    "browserslist-useragent-regexp": "^4.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "cross-env": "^7.0.3",
    "cypress": "^13.17.0",
    "dayjs": "^1.11.13",
    "echarts": "^5.5.1",
    "echarts-for-react": "^3.0.2",
    "events": "^3.3.0",
    "hi-profiles": "^1.1.0",
    "i18next": "^23.16.4",
    "i18next-browser-languagedetector": "^8.0.2",
    "i18next-http-backend": "^3.0.1",
    "lucide-react": "^0.460.0",
    "postcss-loader": "^8.1.1",
    "qrcode.react": "^4.1.0",
    "raviger": "^4.1.2",
    "react": "18.3.1",
    "react-copy-to-clipboard": "^5.1.0",
    "react-dom": "18.3.1",
    "react-google-recaptcha": "^3.1.0",
    "react-i18next": "^15.2.0",
    "react-infinite-scroll-component": "^6.1.0",
    "react-pdf": "^9.2.1",
    "react-webcam": "^7.2.0",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "use-keyboard-shortcut": "^1.1.6",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@julr/vite-plugin-validate-env": "^2.2.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/dompurify": "^3.0.5",
    "@types/events": "^3.0.3",
    "@types/google.maps": "^3.58.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-copy-to-clipboard": "^5.0.7",
    "@types/react-csv": "^1.1.10",
    "@types/react-dom": "^18.3.1",
    "@types/react-google-recaptcha": "^2.1.9",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.4.20",
    "cypress-localstorage-commands": "^2.2.6",
    "cypress-split": "^1.24.5",
    "dompurify": "^3.1.7",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-i18next": "^6.1.0",
    "eslint-plugin-mdx": "^3.1.5",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "fast-check": "^4.10.2",
    "glob": "^11.0.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.10",
    "local-cypress": "^1.2.6",
    "marked": "^14.1.4",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "snyk": "^1.1294.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "uuid": "^11.0.2",
    "vite": "^7.1.9",
    "vite-plugin-checker": "^0.8.0",
    "vite-plugin-pwa": "^1.0.3",
    "vite-plugin-static-copy": "^3.1.3",
    "vitest": "^5.0.5",
    "zod": "^3.25.76"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write --ignore-unknown --plugin prettier-plugin-tailwindcss --plugin @trivago/prettier-plugin-sort-imports",
      "eslint --fix",
      "git update-index --again"
    ],
    "public/locale/*.json": [
      "npm run sort-locales"
    ]
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "packageManager": "npm@10.9.0"
}

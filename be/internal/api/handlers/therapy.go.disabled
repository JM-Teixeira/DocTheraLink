		Preload("Facility").
		Preload("AssignedTherapist").
		Preload("AssignedDoctor")

	if params.Search != "" {
		query = query.Where("name ILIKE ? OR unique_id ILIKE ?", "%"+params.Search+"%", "%"+params.Search+"%")
	}

	var total int64
	query.Count(&total)

	var patients []models.TherapyPatient
	if err := query.Limit(params.Limit).Offset(params.Offset).Find(&patients).Error; err != nil {
		c.JSON(http.StatusInternalServerError, models.ErrorResponse{
			Error:   "internal_error",
			Message: "Failed to fetch patients",
		})
		return
	}

	response := models.PaginatedResponse{
		Count:   int(total),
		Results: patients,
	}

	c.JSON(http.StatusOK, response)
}

func (h *TherapyHandler) GetTreatmentPlan(c *gin.Context) {
	patientID := c.Param("patient_id")

	var plan models.TreatmentPlan
	db := database.GetDB()
	if err := db.Preload("Patient").
		Preload("CreatedBy").
		Preload("LastModifiedBy").
		Where("patient_id = ?", patientID).
		First(&plan).Error; err != nil {
		if err == gorm.ErrRecordNotFound {
			c.JSON(http.StatusNotFound, models.ErrorResponse{
				Error:   "not_found",
				Message: "Treatment plan not found",
			})
			return
		}
		c.JSON(http.StatusInternalServerError, models.ErrorResponse{
			Error:   "internal_error",
			Message: "Database error",
		})
		return
	}

	c.JSON(http.StatusOK, plan)
}


func (h *TherapyHandler) GetPatientStakeholders(c *gin.Context) {
	patientID := c.Param("patient_id")

	var stakeholders []models.PatientStakeholder
	db := database.GetDB()
	if err := db.Preload("User").
		Preload("AddedBy").
		Where("patient_id = ?", patientID).
		Find(&stakeholders).Error; err != nil {
		c.JSON(http.StatusInternalServerError, models.ErrorResponse{
			Error:   "internal_error",
			Message: "Failed to fetch stakeholders",
		})
		return
	}

	response := models.PaginatedResponse{
		Count:   len(stakeholders),
		Results: stakeholders,
	}

	c.JSON(http.StatusOK, response)
}

func (h *TherapyHandler) RemovePatientStakeholder(c *gin.Context) {
	stakeholderID := c.Param("stakeholder_id")

	db := database.GetDB()
	result := db.Where("id = ?", stakeholderID).Delete(&models.PatientStakeholder{})
	if result.Error != nil {
		c.JSON(http.StatusInternalServerError, models.ErrorResponse{
			Error:   "internal_error",
			Message: "Failed to remove stakeholder",
		})
		return
	}

	if result.RowsAffected == 0 {
		c.JSON(http.StatusNotFound, models.ErrorResponse{
			Error:   "not_found",
			Message: "Stakeholder not found",
		})
		return
	}

	c.JSON(http.StatusOK, models.SuccessResponse{
		Message: "Stakeholder removed successfully",
	})
}

func (h *TherapyHandler) ListTherapySessions(c *gin.Context) {
	var params models.QueryParams
	if err := c.ShouldBindQuery(&params); err != nil {
		c.JSON(http.StatusBadRequest, models.ErrorResponse{
			Error:   "bad_request",
			Message: "Invalid query parameters",
		})
		return
	}

	if params.Limit == 0 {
		params.Limit = 20
	}

	db := database.GetDB()
	query := db.Model(&models.TherapySession{}).
		Preload("Patient").
		Preload("Therapist").
		Preload("Section")

	// Filter by date if provided
	if dateStr := c.Query("date"); dateStr != "" {
		query = query.Where("scheduled_date::date = ?", dateStr)
	}

	// Filter by therapist if provided
	if therapistID := c.Query("therapist_id"); therapistID != "" {
		query = query.Where("therapist_id = ?", therapistID)
	}

	// Filter by patient if provided
	if patientID := c.Query("patient_id"); patientID != "" {
		query = query.Where("patient_id = ?", patientID)
	}

	var total int64
	query.Count(&total)

	var sessions []models.TherapySession
	if err := query.Limit(params.Limit).Offset(params.Offset).
		Order("scheduled_date DESC, scheduled_time DESC").
		Find(&sessions).Error; err != nil {
		c.JSON(http.StatusInternalServerError, models.ErrorResponse{
			Error:   "internal_error",
			Message: "Failed to fetch sessions",
		})
		return
	}

	response := models.PaginatedResponse{
		Count:   int(total),
		Results: sessions,
	}

	c.JSON(http.StatusOK, response)
}

func (h *TherapyHandler) GetTherapySession(c *gin.Context) {
	sessionID := c.Param("id")

	var session models.TherapySession
	db := database.GetDB()
	if err := db.Preload("Patient").
		Preload("Therapist").
		Preload("Section").
		Preload("CreatedBy").
		Where("id = ?", sessionID).
		First(&session).Error; err != nil {
		if err == gorm.ErrRecordNotFound {
			c.JSON(http.StatusNotFound, models.ErrorResponse{
				Error:   "not_found",
				Message: "Session not found",
			})
			return
		}
		c.JSON(http.StatusInternalServerError, models.ErrorResponse{
			Error:   "internal_error",
			Message: "Database error",
		})
		return
	}

	c.JSON(http.StatusOK, session)
}


// AddPatientStakeholder godoc
// @Summary Add patient stakeholder
// @Description Add a user as a stakeholder for a patient
// @Tags therapy
// @Accept json
// @Produce json
// @Security BearerAuth
// @Param patient_id path string true "Patient ID"
// @Param stakeholder body object{user_id=int,role=string,is_primary=bool} true "Stakeholder data"
// @Success 201 {object} models.PatientStakeholder
// @Router /therapy/patients/{patient_id}/stakeholders/ [post]
func (h *TherapyHandler) AddPatientStakeholder(c *gin.Context) {
	patientID := c.Param("patient_id")
	
	// Get current user
	claims, err := auth.GetCurrentUserClaims(c)
	if err != nil {
		c.JSON(http.StatusUnauthorized, models.ErrorResponse{
			Error:   "unauthorized",
			Message: "Invalid token",
		})
		return
	}

	var req struct {
		UserID    uint   `json:"user_id" binding:"required"`
		Role      string `json:"role" binding:"required"`
		IsPrimary bool   `json:"is_primary"`
	}
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, models.ErrorResponse{
			Error:   "bad_request",
			Message: "Invalid request body",
		})
		return
	}

	// Create stakeholder
	stakeholder := models.PatientStakeholder{
		PatientID: patientID,
		UserID:    req.UserID,
		Role:      req.Role,
		IsPrimary: req.IsPrimary,
		AddedByID: claims.UserID,
	}

	db := database.GetDB()
	if err := db.Create(&stakeholder).Error; err != nil {
		c.JSON(http.StatusBadRequest, models.ErrorResponse{
			Error:   "bad_request",
			Message: "Failed to add stakeholder",
		})
		return
	}

	// Load relationships
	db.Preload("Patient").Preload("User").Preload("AddedBy").First(&stakeholder, "id = ?", stakeholder.ID)

	c.JSON(http.StatusCreated, stakeholder)
}

// UpdatePatientMissedSessions godoc
// @Summary Update patient missed sessions
// @Description Update the count of missed sessions for a patient
// @Tags therapy
// @Accept json
// @Produce json
// @Security BearerAuth
// @Param patient_id path string true "Patient ID"
// @Param data body object{missed_sessions=int} true "Missed sessions data"
// @Success 200 {object} models.TherapyPatient
// @Router /therapy/patients/{patient_id}/missed-sessions/ [patch]
func (h *TherapyHandler) UpdatePatientMissedSessions(c *gin.Context) {
	patientID := c.Param("patient_id")

	var req struct {
		MissedSessions int `json:"missed_sessions" binding:"required"`
	}
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, models.ErrorResponse{
			Error:   "bad_request",
			Message: "Invalid request body",
		})
		return
	}

	// Update patient
	db := database.GetDB()
	var patient models.TherapyPatient
	if err := db.Where("id = ?", patientID).First(&patient).Error; err != nil {
		c.JSON(http.StatusNotFound, models.ErrorResponse{
			Error:   "not_found",
			Message: "Patient not found",
		})
		return
	}

	patient.MissedSessions = req.MissedSessions
	if err := db.Save(&patient).Error; err != nil {
		c.JSON(http.StatusBadRequest, models.ErrorResponse{
			Error:   "bad_request",
			Message: "Failed to update patient",
		})
		return
	}

	// Load relationships
	db.Preload("Facility").
		Preload("AssignedTherapist").
		Preload("AssignedDoctor").
		First(&patient, "id = ?", patient.ID)

	c.JSON(http.StatusOK, patient)
}


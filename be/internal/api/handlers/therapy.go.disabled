// TherapyHandler handles physical therapy related endpoints
type TherapyHandler struct {
	config *config.Config
}

// NewTherapyHandler creates a new therapy handler
func NewTherapyHandler(cfg *config.Config) *TherapyHandler {
	return &TherapyHandler{
		config: cfg,
	}
}

// CreateFacilitySection godoc
// @Summary Create facility section
// @Description Create a new section within a facility (e.g., Pool Section, Electric Section)
// @Tags therapy
// @Accept json
// @Produce json
// @Security BearerAuth
// @Param facility_id path string true "Facility ID"
// @Param section body models.CreateFacilitySectionRequest true "Section data"
// @Success 201 {object} models.FacilitySection
// @Failure 400 {object} models.ErrorResponse
// @Router /facility/{facility_id}/sections/ [post]
func (h *TherapyHandler) CreateFacilitySection(c *gin.Context) {
	facilityID := c.Param("facility_id")
	
	// Get current user
	claims, err := auth.GetCurrentUserClaims(c)
	if err != nil {
		c.JSON(http.StatusUnauthorized, models.ErrorResponse{
			Error:   "unauthorized",
			Message: "Invalid token",
		})
		return
	}

	var req models.CreateFacilitySectionRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, models.ErrorResponse{
			Error:   "bad_request",
			Message: "Invalid request body",
		})
		return
	}

	// Verify facility exists and user has access
	var facility models.Facility
	db := database.GetDB()
	if err := db.Where("id = ?", facilityID).First(&facility).Error; err != nil {
		c.JSON(http.StatusNotFound, models.ErrorResponse{
			Error:   "not_found",
			Message: "Facility not found",
		})
		return
	}

	// Create section
	section := models.FacilitySection{
		Name:        req.Name,
		Description: req.Description,
		Color:       req.Color,
		FacilityID:  facilityID,
		CreatedByID: claims.UserID,
	}

	if section.Color == "" {
		section.Color = "#3B82F6" // Default blue color
	}

	if err := db.Create(&section).Error; err != nil {
		c.JSON(http.StatusBadRequest, models.ErrorResponse{
			Error:   "bad_request",
			Message: "Failed to create section",
		})
		return
	}

	// Load relationships
	db.Preload("Facility").Preload("CreatedBy").First(&section, "id = ?", section.ID)

	c.JSON(http.StatusCreated, section)
}

// ListFacilitySections godoc
// @Summary List facility sections
// @Description Get all sections for a facility
// @Tags therapy
// @Accept json
// @Produce json
// @Security BearerAuth
// @Param facility_id path string true "Facility ID"
// @Success 200 {object} models.PaginatedResponse
// @Router /facility/{facility_id}/sections/ [get]
func (h *TherapyHandler) ListFacilitySections(c *gin.Context) {
	facilityID := c.Param("facility_id")

	var sections []models.FacilitySection
	db := database.GetDB()
	if err := db.Where("facility_id = ? AND deleted_at IS NULL", facilityID).
		Preload("CreatedBy").
		Find(&sections).Error; err != nil {
		c.JSON(http.StatusInternalServerError, models.ErrorResponse{
			Error:   "internal_error",
			Message: "Failed to fetch sections",
		})
		return
	}

	response := models.PaginatedResponse{
		Count:   len(sections),
		Results: sections,
	}

	c.JSON(http.StatusOK, response)
}

// CreateTherapyPatient godoc
// @Summary Create therapy patient
// @Description Register a new patient for physical therapy
// @Tags therapy
// @Accept json
// @Produce json
// @Security BearerAuth
// @Param patient body models.CreateTherapyPatientRequest true "Patient data"
// @Success 201 {object} models.TherapyPatient
// @Failure 400 {object} models.ErrorResponse
// @Router /therapy/patients/ [post]
func (h *TherapyHandler) CreateTherapyPatient(c *gin.Context) {
	// Get current user
	claims, err := auth.GetCurrentUserClaims(c)
	if err != nil {
		c.JSON(http.StatusUnauthorized, models.ErrorResponse{
			Error:   "unauthorized",
			Message: "Invalid token",
		})
		return
	}

	var req models.CreateTherapyPatientRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, models.ErrorResponse{
			Error:   "bad_request",
			Message: "Invalid request body",
		})
		return
	}

	// Get user's facility (assuming they have a home facility)
	var user models.User
	db := database.GetDB()
	if err := db.Where("id = ?", claims.UserID).First(&user).Error; err != nil {
		c.JSON(http.StatusNotFound, models.ErrorResponse{
			Error:   "not_found",
			Message: "User not found",
		})
		return
	}

	if user.HomeFacilityID == nil {
		c.JSON(http.StatusBadRequest, models.ErrorResponse{
			Error:   "bad_request",
			Message: "User must be assigned to a facility",
		})
		return
	}

	// Create patient
	patient := models.TherapyPatient{
		Name:                req.Name,
		DateOfBirth:         req.DateOfBirth,
		Gender:              req.Gender,
		PhoneNumber:         req.PhoneNumber,
		EmergencyContact:    req.EmergencyContact,
		Address:             req.Address,
		MedicalHistory:      req.MedicalHistory,
		AdmissionDate:       time.Now(),
		TreatmentType:       req.TreatmentType,
		ReferringDoctor:     req.ReferringDoctor,
		DiagnosisNotes:      req.DiagnosisNotes,
		TreatmentGoals:      req.TreatmentGoals,
		FacilityID:          *user.HomeFacilityID,
		AssignedTherapistID: req.AssignedTherapistID,
		AssignedDoctorID:    req.AssignedDoctorID,
		CreatedByID:         claims.UserID,
	}

	if err := db.Create(&patient).Error; err != nil {
		c.JSON(http.StatusBadRequest, models.ErrorResponse{
			Error:   "bad_request",
			Message: "Failed to create patient",
		})
		return
	}

	// Load relationships
	db.Preload("Facility").
		Preload("AssignedTherapist").
		Preload("AssignedDoctor").
		Preload("CreatedBy").
		First(&patient, "id = ?", patient.ID)

	c.JSON(http.StatusCreated, patient)
}

// GetTherapyPatient godoc
// @Summary Get therapy patient
// @Description Get therapy patient details
// @Tags therapy
// @Accept json
// @Produce json
// @Security BearerAuth
// @Param id path string true "Patient ID"
// @Success 200 {object} models.TherapyPatient
// @Router /therapy/patients/{id}/ [get]
func (h *TherapyHandler) GetTherapyPatient(c *gin.Context) {
	id := c.Param("id")

	var patient models.TherapyPatient
	db := database.GetDB()
	if err := db.Preload("Facility").
		Preload("AssignedTherapist").
		Preload("AssignedDoctor").
		Preload("CreatedBy").
		Preload("TreatmentPlan").
		Preload("Stakeholders.User").
		Where("id = ?", id).
		First(&patient).Error; err != nil {
		if err == gorm.ErrRecordNotFound {
			c.JSON(http.StatusNotFound, models.ErrorResponse{
				Error:   "not_found",
				Message: "Patient not found",
			})
			return
		}
		c.JSON(http.StatusInternalServerError, models.ErrorResponse{
			Error:   "internal_error",
			Message: "Database error",
		})
		return
	}

	c.JSON(http.StatusOK, patient)
}

// CreateTreatmentPlan godoc
// @Summary Create treatment plan (P1)
// @Description Create a treatment plan for a patient
// @Tags therapy
// @Accept json
// @Produce json
// @Security BearerAuth
// @Param patient_id path string true "Patient ID"
// @Param plan body models.CreateTreatmentPlanRequest true "Treatment plan data"
// @Success 201 {object} models.TreatmentPlan
// @Router /therapy/patients/{patient_id}/treatment-plan/ [post]
func (h *TherapyHandler) CreateTreatmentPlan(c *gin.Context) {
	patientID := c.Param("patient_id")
	
	// Get current user
	claims, err := auth.GetCurrentUserClaims(c)
	if err != nil {
		c.JSON(http.StatusUnauthorized, models.ErrorResponse{
			Error:   "unauthorized",
			Message: "Invalid token",
		})
		return
	}

	var req models.CreateTreatmentPlanRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, models.ErrorResponse{
			Error:   "bad_request",
			Message: "Invalid request body",
		})
		return
	}

	// Verify patient exists
	var patient models.TherapyPatient
	db := database.GetDB()
	if err := db.Where("id = ?", patientID).First(&patient).Error; err != nil {
		c.JSON(http.StatusNotFound, models.ErrorResponse{
			Error:   "not_found",
			Message: "Patient not found",
		})
		return
	}

	// Create treatment plan
	plan := models.TreatmentPlan{
		PatientID:         patientID,
		Diagnosis:         req.Diagnosis,
		TreatmentGoals:    req.TreatmentGoals,
		TreatmentPlan:     req.TreatmentPlan,
		Frequency:         req.Frequency,
		Duration:          req.Duration,
		Precautions:       req.Precautions,
		Contraindications: req.Contraindications,
		InitialAssessment: req.InitialAssessment,
		StartDate:         time.Now(),
		CreatedByID:       claims.UserID,
	}

	if err := db.Create(&plan).Error; err != nil {
		c.JSON(http.StatusBadRequest, models.ErrorResponse{
			Error:   "bad_request",
			Message: "Failed to create treatment plan",
		})
		return
	}

	// Load relationships
	db.Preload("Patient").Preload("CreatedBy").First(&plan, "id = ?", plan.ID)

	c.JSON(http.StatusCreated, plan)
}

// CreateTherapySession godoc
// @Summary Create therapy session
// @Description Schedule a new therapy session
// @Tags therapy
// @Accept json
// @Produce json
// @Security BearerAuth
// @Param session body models.CreateTherapySessionRequest true "Session data"
// @Success 201 {object} models.TherapySession
// @Router /therapy/sessions/ [post]
func (h *TherapyHandler) CreateTherapySession(c *gin.Context) {
	// Get current user
	claims, err := auth.GetCurrentUserClaims(c)
	if err != nil {
		c.JSON(http.StatusUnauthorized, models.ErrorResponse{
			Error:   "unauthorized",
			Message: "Invalid token",
		})
		return
	}

	var req models.CreateTherapySessionRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, models.ErrorResponse{
			Error:   "bad_request",
			Message: "Invalid request body",
		})
		return
	}

	// Set default duration if not provided
	if req.Duration == 0 {
		req.Duration = 60 // 60 minutes default
	}

	// Create session
	session := models.TherapySession{
		PatientID:     req.PatientID,
		TherapistID:   req.TherapistID,
		SectionID:     req.SectionID,
		ScheduledDate: req.ScheduledDate,
		ScheduledTime: req.ScheduledTime,
		Duration:      req.Duration,
		CreatedByID:   claims.UserID,
	}

	db := database.GetDB()
	if err := db.Create(&session).Error; err != nil {
		c.JSON(http.StatusBadRequest, models.ErrorResponse{
			Error:   "bad_request",
			Message: "Failed to create session",
		})
		return
	}

	// Load relationships
	db.Preload("Patient").
		Preload("Therapist").
		Preload("Section").
		Preload("CreatedBy").
		First(&session, "id = ?", session.ID)

	c.JSON(http.StatusCreated, session)
}

// GetTimetable godoc
// @Summary Get facility timetable
// @Description Get timetable view for a facility showing therapist-patient-section assignments
// @Tags therapy
// @Accept json
// @Produce json
// @Security BearerAuth
// @Param facility_id path string true "Facility ID"
// @Param date query string false "Date (YYYY-MM-DD format)"
// @Success 200 {object} models.TimetableResponse
// @Router /therapy/facilities/{facility_id}/timetable/ [get]
func (h *TherapyHandler) GetTimetable(c *gin.Context) {
	facilityID := c.Param("facility_id")
	dateStr := c.Query("date")
	
	// Parse date or use today
	var targetDate time.Time
	var err error
	if dateStr != "" {
		targetDate, err = time.Parse("2006-01-02", dateStr)
		if err != nil {
			c.JSON(http.StatusBadRequest, models.ErrorResponse{
				Error:   "bad_request",
				Message: "Invalid date format. Use YYYY-MM-DD",
			})
			return
		}
	} else {
		targetDate = time.Now()
	}

	// Get sessions for the date
	db := database.GetDB()
	var sessions []models.TherapySession
	if err := db.Preload("Patient").
		Preload("Therapist").
		Preload("Section").
		Where("scheduled_date::date = ? AND patient.facility_id = ?", 
			targetDate.Format("2006-01-02"), facilityID).
		Joins("JOIN therapy_patients patient ON patient.id = therapy_sessions.patient_id").
		Find(&sessions).Error; err != nil {
		c.JSON(http.StatusInternalServerError, models.ErrorResponse{
			Error:   "internal_error",
			Message: "Failed to fetch timetable",
		})
		return
	}

	// Convert to timetable entries
	var entries []models.TimetableEntry
	for _, session := range sessions {
		entry := models.TimetableEntry{
			ID:            session.ID,
			PatientID:     session.PatientID,
			PatientName:   session.Patient.Name,
			TherapistID:   session.TherapistID,
			TherapistName: session.Therapist.FirstName + " " + session.Therapist.LastName,
			SectionID:     session.SectionID,
			SectionName:   session.Section.Name,
			SectionColor:  session.Section.Color,
			StartTime:     session.ScheduledTime,
			EndTime:       session.ScheduledTime.Add(time.Duration(session.Duration) * time.Minute),
			Status:        session.Status,
			Duration:      session.Duration,
		}
		entries = append(entries, entry)
	}

	response := models.TimetableResponse{
		Date:    targetDate,
		Entries: entries,
	}

	c.JSON(http.StatusOK, response)
}

// GetTherapistTimetable godoc
// @Summary Get therapist personal timetable
// @Description Get timetable for a specific therapist
// @Tags therapy
// @Accept json
// @Produce json
// @Security BearerAuth
// @Param therapist_id path string true "Therapist ID"
// @Param date query string false "Date (YYYY-MM-DD format)"
// @Success 200 {object} models.TimetableResponse
// @Router /therapy/therapists/{therapist_id}/timetable/ [get]
func (h *TherapyHandler) GetTherapistTimetable(c *gin.Context) {
	therapistIDStr := c.Param("therapist_id")
	dateStr := c.Query("date")
	
	// Parse therapist ID
	therapistID, err := strconv.ParseUint(therapistIDStr, 10, 32)
	if err != nil {
		c.JSON(http.StatusBadRequest, models.ErrorResponse{
			Error:   "bad_request",
			Message: "Invalid therapist ID",
		})
		return
	}
	
	// Parse date or use today
	var targetDate time.Time
	if dateStr != "" {
		targetDate, err = time.Parse("2006-01-02", dateStr)
		if err != nil {
			c.JSON(http.StatusBadRequest, models.ErrorResponse{
				Error:   "bad_request",
				Message: "Invalid date format. Use YYYY-MM-DD",
			})
			return
		}
	} else {
		targetDate = time.Now()
	}

	// Get sessions for the therapist and date
	db := database.GetDB()
	var sessions []models.TherapySession
	if err := db.Preload("Patient").
		Preload("Therapist").
		Preload("Section").
		Where("therapist_id = ? AND scheduled_date::date = ?", 
			uint(therapistID), targetDate.Format("2006-01-02")).
		Find(&sessions).Error; err != nil {
		c.JSON(http.StatusInternalServerError, models.ErrorResponse{
			Error:   "internal_error",
			Message: "Failed to fetch therapist timetable",
		})
		return
	}

	// Convert to timetable entries
	var entries []models.TimetableEntry
	for _, session := range sessions {
		entry := models.TimetableEntry{
			ID:            session.ID,
			PatientID:     session.PatientID,
			PatientName:   session.Patient.Name,
			TherapistID:   session.TherapistID,
			TherapistName: session.Therapist.FirstName + " " + session.Therapist.LastName,
			SectionID:     session.SectionID,
			SectionName:   session.Section.Name,
			SectionColor:  session.Section.Color,
			StartTime:     session.ScheduledTime,
			EndTime:       session.ScheduledTime.Add(time.Duration(session.Duration) * time.Minute),
			Status:        session.Status,
			Duration:      session.Duration,
		}
		entries = append(entries, entry)
	}

	response := models.TimetableResponse{
		Date:    targetDate,
		Entries: entries,
	}

	c.JSON(http.StatusOK, response)
}

// UpdateSessionNotes godoc
// @Summary Update therapy session notes
// @Description Update notes and assessment for a therapy session
// @Tags therapy
// @Accept json
// @Produce json
// @Security BearerAuth
// @Param id path string true "Session ID"
// @Param notes body models.UpdateSessionNotesRequest true "Session notes"
// @Success 200 {object} models.TherapySession
// @Router /therapy/sessions/{id}/notes/ [patch]
func (h *TherapyHandler) UpdateSessionNotes(c *gin.Context) {
	sessionID := c.Param("id")

	var req models.UpdateSessionNotesRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, models.ErrorResponse{
			Error:   "bad_request",
			Message: "Invalid request body",
		})
		return
	}

	// Get session
	var session models.TherapySession
	db := database.GetDB()
	if err := db.Where("id = ?", sessionID).First(&session).Error; err != nil {
		c.JSON(http.StatusNotFound, models.ErrorResponse{
			Error:   "not_found",
			Message: "Session not found",
		})
		return
	}

	// Update session notes
	updates := make(map[string]interface{})
	if req.TreatmentNotes != nil {
		updates["treatment_notes"] = *req.TreatmentNotes
	}
	if req.ProgressNotes != nil {
		updates["progress_notes"] = *req.ProgressNotes
	}
	if req.HomeExercises != nil {
		updates["home_exercises"] = *req.HomeExercises
	}
	if req.NextSessionPlan != nil {
		updates["next_session_plan"] = *req.NextSessionPlan
	}
	if req.PainLevel != nil {
		updates["pain_level"] = *req.PainLevel
	}
	if req.FunctionLevel != nil {
		updates["function_level"] = *req.FunctionLevel
	}
	if req.PatientResponse != nil {
		updates["patient_response"] = *req.PatientResponse
	}
	if req.Status != nil {
		updates["status"] = *req.Status
		if *req.Status == "completed" {
			updates["actual_end_time"] = time.Now()
			if session.ActualStartTime == nil {
				updates["actual_start_time"] = time.Now().Add(-time.Duration(session.Duration) * time.Minute)
			}
		}
	}

	if err := db.Model(&session).Updates(updates).Error; err != nil {
		c.JSON(http.StatusBadRequest, models.ErrorResponse{
			Error:   "bad_request",
			Message: "Failed to update session",
		})
		return
	}

	// Load updated session with relationships
	db.Preload("Patient").
		Preload("Therapist").
		Preload("Section").
		First(&session, "id = ?", session.ID)

	c.JSON(http.StatusOK, session)
}


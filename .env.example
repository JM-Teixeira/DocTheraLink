# Copy to .env and fill in. .env is git-ignored — never commit real secrets.

# Database
DB_NAME=care
DB_USER=care
DB_PASSWORD=change-me

# Auth — generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_EXPIRY=1h
JWT_REFRESH_EXPIRY=168h

# Mode: "debug" for local work, "release" for anything shared.
# Release mode refuses weak JWT secrets and demo users.
GIN_MODE=debug
# Demo accounts (doctor, physiotherapist, nurse, ... password 1234@1). Never enable outside local dev.
SEED_DEMO_USERS=true
ENABLE_SWAGGER=true

# URL users open in the browser
PUBLIC_URL=http://localhost:4000
CORS_ALLOWED_ORIGINS=http://localhost:4000
